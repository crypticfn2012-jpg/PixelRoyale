{
  "name": "pixelroyale-desktop",
  "version": "1.0.5",
  "description": "PixelRoyale portable Windows desktop client",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node make-icon.js && node prepare-game.js && electron .",
    "build:portable": "node make-icon.js && node prepare-game.js && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.5",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.pixelroyale.desktop",
    "productName": "PixelRoyale",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/icon.ico",
      "game/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PixelRoyale-Portable-${version}.${ext}"
    },
    "compression": "store"
  }
}
